{
  "description": "Deterministic push safety and delivery completion gates.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${DROID_PLUGIN_ROOT}/hooks/prompt_submit.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${DROID_PLUGIN_ROOT}/hooks/delivery_ledger.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Execute",
        "commandRegex": "(^|&&|\\|\\||;|\\|)\\s*git\\s+(?:(?:-C|-c|--git-dir|--work-tree)\\s+\\S+\\s+|-C\\S+\\s+|-[^\\s]+\\s+)*push\\b",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${DROID_PLUGIN_ROOT}/hooks/pre_push_policy.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${DROID_PLUGIN_ROOT}/hooks/review_budget.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Execute",
        "commandRegex": "(^|&&|\\|\\||;|\\|)\\s*git\\s+(?:(?:-C|-c|--git-dir|--work-tree)\\s+\\S+\\s+|-C\\S+\\s+|-[^\\s]+\\s+)*push\\b",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${DROID_PLUGIN_ROOT}/hooks/delivery_ledger.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${DROID_PLUGIN_ROOT}/hooks/stop_delivery_gate.py\"",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
